{
  "name": "agents-league",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered collaborative whiteboard built with Next.js, TypeScript, and Tailwind CSS.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "format-check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "prepare": "husky"
  },
  "repository": {
